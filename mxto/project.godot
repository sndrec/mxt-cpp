[native_extensions]

paths=PackedStringArray("res://bin/gamesim.gdextension")

[netplay]

time/tickrate=60
time/max_ticks_per_frame=15
time/recalibrate_threshold=1.0
rollback/input_redundancy=5

[network]

limits/debugger/max_chars_per_second=262144
limits/debugger/max_queued_messages=8192
limits/debugger/max_errors_per_second=800
limits/debugger/max_warnings_per_second=800

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/atlas_16_bits=false
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/use_debanding=true
textures/default_filters/texture_mipmap_bias=-1.0
environment/glow/upscale_mode=0
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

vehicle_screen_tex={
"type": "sampler2D",
"value": ""
}
vehicle_outline_screen_tex={
"type": "sampler2D",
"value": ""
}
fog_dist={
"type": "float",
"value": 1000.0
}
fog_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}

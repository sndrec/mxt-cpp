[sub_resource type="Shader" id="Shader_q4p32"]
code = "shader_type spatial;
render_mode depth_draw_always, cull_disabled, unshaded;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);
global uniform float fog_dist;
const float THRUSTER_REFERENCE_PROJECTION_Y = 1.3763819; // cot(72 degrees / 2)

#include \"res://asset/shader/ordered_dither.gdshaderinc\"

varying flat float instance_visibility;
varying flat float camera_behind_vehicle;

void vertex() {
	instance_visibility = INSTANCE_CUSTOM.a;
	vec3 vehicle_back = normalize(MODEL_MATRIX[2].xyz);
	camera_behind_vehicle = step(0.0, dot(INV_VIEW_MATRIX[3].xyz - MODEL_MATRIX[3].xyz, vehicle_back));
	float thrust_scale = max(INSTANCE_CUSTOM.x, 0.0);
	VERTEX.x *= (sin(TIME * 120.0 + INSTANCE_CUSTOM.y) * 0.1 + 1.2) * thrust_scale;
	VERTEX.y *= (cos(TIME * 90.0 + INSTANCE_CUSTOM.y) * 0.02 + 0.75) * thrust_scale;

	mat4 mat_world = mat4(
			normalize(INV_VIEW_MATRIX[0]),
			normalize(INV_VIEW_MATRIX[1]),
			normalize(INV_VIEW_MATRIX[2]),
			MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat_world;
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);

	if (PROJECTION_MATRIX[3][3] != 0.0) {
		float h = abs(1.0 / (2.0 * PROJECTION_MATRIX[1][1]));
		MODELVIEW_MATRIX[0] *= h * 2.0;
		MODELVIEW_MATRIX[1] *= h * 2.0;
		MODELVIEW_MATRIX[2] *= h * 2.0;
	} else {
		float depth = max(0.001, -MODELVIEW_MATRIX[3].z);
		float fov_scale = THRUSTER_REFERENCE_PROJECTION_Y / max(abs(PROJECTION_MATRIX[1][1]), 0.0001);
		float sc = depth * (15.0 / pow(depth, 0.5)) * 0.2 * fov_scale;
		MODELVIEW_MATRIX[0] *= sc;
		MODELVIEW_MATRIX[1] *= sc;
		MODELVIEW_MATRIX[2] *= sc;
	}
}

void fragment() {
	vec4 albedo_tex = texture(texture_albedo, UV);
	float albedo_float = albedo_tex.r + 0.49;
	float outline = round(albedo_float);
	float inline = round(albedo_float - 0.1);
	float coverage = outline * instance_visibility * track_distance_fade_coverage(VERTEX, fog_dist);
	float threshold = ordered_dither_threshold(FRAGCOORD, UV);
	threshold = mix(0.5, threshold, dither_strength);
	if (coverage < threshold) {
		discard;
	}
	ALBEDO = vec3(outline * 0.5 + inline) * vec3(0.3, 0.7, 1.0) * 0.75;
	DEPTH = mix(FRAGCOORD.z, FRAGCOORD.z * 1.1, camera_behind_vehicle);
}
"


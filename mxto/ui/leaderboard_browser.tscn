[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/leaderboard_browser.gd" id="1_browser"]

[node name="Leaderboards" type="VBoxContainer"]
layout_mode = 2
script = ExtResource("1_browser")

[node name="Status" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Steam Leaderboards"

[node name="Summary" type="Label" parent="."]
layout_mode = 2
text = "Select a leaderboard view."

[node name="Controls" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Track" type="OptionButton" parent="Controls"]
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 3

[node name="Global" type="Button" parent="Controls"]
layout_mode = 2
text = "Global Top 100"

[node name="AroundMe" type="Button" parent="Controls"]
layout_mode = 2
text = "Around Me"

[node name="Friends" type="Button" parent="Controls"]
layout_mode = 2
text = "Friends"

[node name="Refresh" type="Button" parent="Controls"]
layout_mode = 2
text = "Refresh"

[node name="Entries" type="Tree" parent="."]
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
size_flags_vertical = 3
column_titles_visible = true
select_mode = 1

[node name="EntryActions" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="WatchReplay" type="Button" parent="EntryActions"]
layout_mode = 2
disabled = true
text = "Watch Verified Replay"

[node name="ReplayHint" type="Label" parent="EntryActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Replay availability is shown by the selected verified entry."

[node name="History" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="DetailsScroll" type="ScrollContainer" parent="History"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Details" type="RichTextLabel" parent="History/DetailsScroll"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false

[node name="Actions" type="HBoxContainer" parent="History"]
layout_mode = 2

[node name="RetryPending" type="Button" parent="History/Actions"]
layout_mode = 2
text = "Retry Pending Now"

[node name="ClearRejected" type="Button" parent="History/Actions"]
layout_mode = 2
text = "Clear Rejected History"

[sub_resource type="SphereMesh" id="SphereMesh_garage_backdrop"]
radius = 42.0
height = 84.0

[sub_resource type="Shader" id="Shader_garage_backdrop"]
code = "shader_type spatial;
render_mode unshaded, cull_front, depth_draw_never, blend_add;

uniform vec4 horizon_color : source_color = vec4(0.075, 0.09, 0.115, 1.0);
uniform vec4 zenith_color : source_color = vec4(0.018, 0.022, 0.032, 1.0);

void fragment() {
	float gradient = smoothstep(-0.35, 0.95, normalize(VERTEX).y);
	ALBEDO = mix(horizon_color.rgb, zenith_color.rgb, gradient);
}"


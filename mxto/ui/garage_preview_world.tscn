[sub_resource type="Shader" id="Shader_garage_grid"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_add;

uniform vec4 line_color : source_color = vec4(0.5, 0.5, 0.5, 1.0);
uniform float grid_scale = 128.0;
uniform float line_strength = 0.08;

void fragment() {
	vec2 coord = UV * grid_scale;
	vec2 grid = abs(fract(coord - 0.5) - 0.5) / fwidth(coord);
	float line = 1.0 - clamp(min(grid.x, grid.y), 0.0, 1.0);
	float dist_strength = max(0.0, 1.0 - distance(UV, vec2(0.5)) * 2.0);
	dist_strength = pow(dist_strength, 3);
	ALBEDO = mix(vec3(0), line_color.rgb, line * line_strength * dist_strength);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_garage_grid"]

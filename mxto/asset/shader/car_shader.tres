[gd_resource type="Shader" format=3 uid="uid://7mpno1grslv6"]

[resource]
code = "// NOTE: Shader automatically converted from Godot Engine 4.2.rc1's StandardMaterial3D.

shader_type spatial;
render_mode cull_back,depth_draw_always;
uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color,filter_linear_mipmap,repeat_enable;
global uniform float race_time_elapsed;
global uniform float fog_dist;

#include \"res://asset/shader/ordered_dither.gdshaderinc\"

void fragment() {

	if (UV2.y < -1.0 || UV2.y > 0.0){
		discard;
	}
	DEPTH = FRAGCOORD.z;
	//if (UV2.y < 1.0){
	vec3 ndc = vec3(SCREEN_UV * 2.0 - 1.0, DEPTH);
	vec4 view = INV_PROJECTION_MATRIX * vec4(ndc, 1.0);
	view.xyz /= view.w;
	float linear_depth = -view.z;
	if (race_time_elapsed <= 6.0){
		linear_depth -= 1.0;
	}
	view.z = -linear_depth;
	view.xyz *= view.w;
	view = PROJECTION_MATRIX * view;
	DEPTH = view.z;

	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv);
	float coverage = 0.3 * track_distance_fade_coverage(VERTEX, fog_dist);
	float threshold = ordered_dither_threshold(FRAGCOORD, UV);
	threshold = mix(0.5, threshold, dither_strength);
	if (coverage < threshold) {
		discard;
	}
	ALBEDO = albedo_tex.rgb * albedo.rgb * UV.y;
	SPECULAR = 0.0;
}
"

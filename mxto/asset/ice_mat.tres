[sub_resource type="Shader" id="Shader_8yl70"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.rc1's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_always, fog_disabled, cull_disabled;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D in_lightwarp : repeat_disable, filter_nearest;
uniform vec3 uv1_scale;
global uniform float fog_dist;

void vertex() {
	UV = UV * uv1_scale.xy;
}

void fragment() {
	vec2 base_uv = UV * 4.0;
	vec4 albedo_tex = texture(texture_albedo, base_uv, -1.0);
	vec3 use_color = vec3(0.0, 0.0, 0.0);
	if (!FRONT_FACING)
	{
		use_color = vec3(0.1, 0.0, 0.0);
	}
	ALBEDO = albedo.rgb * albedo_tex.rgb * (sin(TIME * 4.0) / PI + 1.0) + use_color;

	METALLIC = 0.0;
	SPECULAR = 0.0;
	ROUGHNESS = 1.0;
	float fog_mix = max(0.0, (length(VERTEX) - 500.0) / fog_dist);
	fog_mix = clamp(pow(fog_mix, 2.0), 0.0, 1.0);
	fog_mix = sin(fog_mix * PI * 0.5);
	ALPHA = 1.0 - fog_mix;
}

float fresnel(float amount, vec3 normal, vec3 view)
{
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0 )), amount);
}

void light() {
	float light_val = (dot(NORMAL, LIGHT) * ATTENUATION) * 0.5 + 0.5;
	//float fres = 1.0 - fresnel(1.0, NORMAL, VIEW);
	//float fres_outline = fresnel(16.0, NORMAL, VIEW);
	//light_val = max(light_val - fres * 0.05, 0.0);
	//light_val = max(light_val + fres_outline * 0.15, 0.0);
	vec3  H		= normalize(LIGHT + VIEW);		// half-vector
	float ndoth	= max(dot(NORMAL, H), 0.0);
	float spec	= pow(ndoth, 8.0) * ATTENUATION;
	//light_val = max(light_val + spec * 1.0, 0.0);
	vec3 final_light_val = texture(in_lightwarp, vec2(light_val, 0.0f)).rgb;
	DIFFUSE_LIGHT += final_light_val * LIGHT_COLOR * 1.0;// * 0.3;
	//SPECULAR_LIGHT = vec3(0.0);
}"


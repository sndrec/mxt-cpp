[sub_resource type="Shader" id="Shader_8yl70"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.rc1's StandardMaterial3D.
// Modified to use ordered binary transparency (discard) driven by an alpha-probability.

shader_type spatial;
render_mode blend_mix, unshaded, depth_draw_always, fog_disabled, cull_disabled, ambient_light_disabled;

uniform vec4 albedo_1 : source_color;
uniform vec4 albedo_2 : source_color;
uniform vec4 albedo_1_glow : source_color;
uniform vec4 albedo_2_glow : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_dither : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D in_lightwarp : repeat_disable, filter_nearest;
uniform vec3 uv1_scale;
global uniform float fog_dist;

#include \"res://asset/shader/ordered_dither.gdshaderinc\"

void vertex() {
	UV = UV * uv1_scale.xy;
}

void fragment() {
	vec2 base_uv = UV;
	float albedo_tex = texture(texture_albedo, base_uv).r;
	vec3 use_color = vec3(0.0, 0.0, 0.0);
	if (!FRONT_FACING)
	{
		use_color = vec3(0.1, 0.0, 0.0);
	}
	float mix_factor = min(1.0, length(VERTEX) * 0.002);
	mix_factor = pow(mix_factor, 0.2);
	float glow_mult = sin(UV.y * 2.0 + TIME * -4.0) / PI + 1.0;
	glow_mult *= 0.5;
	glow_mult = glow_mult + texture(texture_dither, base_uv, 1.0).r;
	glow_mult = floor(glow_mult * 5.0) / 5.0;
	glow_mult *= 0.4;
	glow_mult += 0.1;
	vec3 use_albedo = mix(mix(albedo_1.rgb, albedo_1_glow.rgb, glow_mult), mix(albedo_2.rgb, albedo_2_glow.rgb, glow_mult), mix_factor);
	albedo_tex = albedo_tex + texture(texture_dither, base_uv, 1.0).r;
	albedo_tex = floor(albedo_tex * 4.0) / 4.0;
	albedo_tex *= 0.4;
	albedo_tex += 0.1;
	ALBEDO = use_albedo * albedo_tex + use_color;

	METALLIC = 0.0;
	SPECULAR = 0.0;
	ROUGHNESS = 1.0;

	// compute fog-based alpha target (probability that a pixel is kept)
	float fog_mix = max(0.0, (length(VERTEX) - 500.0) / fog_dist);
	fog_mix = clamp(pow(fog_mix, 2.0), 0.0, 1.0);
	fog_mix = sin(fog_mix * PI * 0.5);
	float alpha_prob = 1.0 - fog_mix; // this is the chance to KEEP the pixel

	float threshold = ordered_dither_threshold(FRAGCOORD, UV);
	threshold = mix(0.5, threshold, dither_strength);
	if (alpha_prob < threshold) {
		discard;
	}
}

float fresnel(float amount, vec3 normal, vec3 view)
{
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0 )), amount);
}

void light() {
	float light_val = (dot(NORMAL, LIGHT) * ATTENUATION) * 0.5 + 0.5;
	vec3  H		= normalize(LIGHT + VIEW);
	float ndoth	= max(dot(NORMAL, H), 0.0);
	float spec	= pow(ndoth, 8.0) * ATTENUATION;
	vec3 final_light_val = texture(in_lightwarp, vec2(light_val, 0.0f)).rgb;
	DIFFUSE_LIGHT += final_light_val * LIGHT_COLOR * 1.0;
}
"


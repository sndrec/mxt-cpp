[sub_resource type="Shader" id="Shader_074og"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.rc1's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, cull_disabled, unshaded, fog_disabled;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
global uniform float fog_dist;

#include \"res://asset/shader/ordered_dither.gdshaderinc\"

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
	vec2 base_uv = UV;
	base_uv += vec2(TIME * 0.025, TIME * 0.0125);
	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo_tex.rgb * albedo.rgb;
	float fog_mix = (length(VERTEX) - 500.0) / (fog_dist * 3.0);
	fog_mix = clamp(fog_mix, 0.0, 1.0);
	fog_mix = sin(fog_mix * PI * 0.5);
	float alpha_prob = min(1.0, length(VERTEX) * 0.0006) * 0.6;
	alpha_prob *= albedo_tex.a * (1.0 - fog_mix);
	float threshold = ordered_dither_threshold(FRAGCOORD, UV);
	threshold = mix(0.5, threshold, dither_strength);
	if (alpha_prob < threshold) {
		discard;
	}
}
"


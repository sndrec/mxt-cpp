[sub_resource type="Shader" id="Shader_yaehf"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.rc1's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, world_vertex_coords, depth_draw_never, cull_back, unshaded, ambient_light_disabled, fog_disabled;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform vec3 uv1_scale;
global uniform float fog_dist;
varying vec3 WORLD_VERTEX;


void vertex() {
	UV = UV * uv1_scale.xy;
	WORLD_VERTEX = VERTEX;
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	float fog_mix = (length(WORLD_VERTEX.xz - CAMERA_POSITION_WORLD.xz) - 1000.0) / (fog_dist * 5.0);
	fog_mix = clamp(pow(fog_mix, 1.5), 0.0, 1.0);
	fog_mix = sin(fog_mix * PI * 0.5);
	ALPHA = 1.0 - fog_mix;
	ALBEDO = albedo.rgb * albedo_tex.rgb;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_074og"]
render_priority = 0
shader = SubResource("Shader_yaehf")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/texture_albedo = ExtResource("16_yaehf")
shader_parameter/uv1_scale = Vector3(16, 16, 8)


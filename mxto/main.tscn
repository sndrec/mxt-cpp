[sub_resource type="Shader" id="Shader_074og"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.rc1's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, cull_disabled, depth_draw_never, unshaded, fog_disabled;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
global uniform float fog_dist;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
	vec2 base_uv = UV;
	base_uv += vec2(TIME * 0.025, TIME * 0.0125);
	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo_tex.rgb * albedo.rgb;
	ALPHA = min(1.0, length(VERTEX) * 0.0006) * 0.6;
	float fog_mix = (length(VERTEX) - 500.0) / (fog_dist * 3.0);
	fog_mix = clamp(fog_mix, 0.0, 1.0);
	fog_mix = sin(fog_mix * PI * 0.5);
	ALPHA *= albedo_tex.a * (1.0 - fog_mix);
}
"

